{
  "//": [
    "SSGMS Web Panel — Firestore composite indexes.",
    "Deploy:  firebase deploy --only firestore:indexes",
    "",
    "Firestore creates single-field indexes automatically; only multi-field",
    "queries and range+orderBy combinations need entries here.",
    "",
    "The members list supports filtering by yojna, age group, agent, status,",
    "payment status and a join-date range, in any combination — every filter",
    "adds a where() to the same query, and each distinct shape needs its own",
    "index. The entries below cover the combinations the UI can actually",
    "produce. If you hit a 'query requires an index' error, Firestore's error",
    "message contains a direct creation link; add the equivalent entry here so",
    "the index survives a redeploy."
  ],
  "indexes": [
    {
      "//": "Members: base list — delete_flag + status + sort",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: join-date range (fromDate/toDate filter)",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "joinDateTs", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: filtered by yojna",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "programId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: yojna + join-date range",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "programId", "order": "ASCENDING" },
        { "fieldPath": "joinDateTs", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: yojna + age group",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "programId", "order": "ASCENDING" },
        { "fieldPath": "ageGroupId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: yojna + age group + join-date range",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "programId", "order": "ASCENDING" },
        { "fieldPath": "ageGroupId", "order": "ASCENDING" },
        { "fieldPath": "joinDateTs", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: filtered by agent",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "agentId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: agent + yojna",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "agentId", "order": "ASCENDING" },
        { "fieldPath": "programId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: agent + join-date range",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "agentId", "order": "ASCENDING" },
        { "fieldPath": "joinDateTs", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: active/inactive filter",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "active_flag", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: closed (marriage) filter",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "member_closed", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: payment status filter",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "paymentPercentage", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: keyword search",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "search_keywords", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Members: sort by registration number",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "delete_flag", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "search_registrationNumber", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Members: agent stat recalculation (agentId + status)",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "agentId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Members: registration-number generation (programId + active_flag)",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "programId", "order": "ASCENDING" },
        { "fieldPath": "active_flag", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Requests page: pending / rejected member lists",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "delete_flag", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Copy-from-member search",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "search_keywords", "arrayConfig": "CONTAINS" },
        { "fieldPath": "delete_flag", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Payment history: groups by type + date",
      "collectionGroup": "paymentGroups",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "paymentType", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Payment history: groups by agent + date",
      "collectionGroup": "paymentGroups",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "agentId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Payment history: agent + type + date",
      "collectionGroup": "paymentGroups",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "agentId", "order": "ASCENDING" },
        { "fieldPath": "paymentType", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Join fee transactions by member, newest first",
      "collectionGroup": "memberJoinFees",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "memberId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Join fee transactions by agent, newest first",
      "collectionGroup": "memberJoinFees",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "agentId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Closing fee transactions by member, newest first",
      "collectionGroup": "memberClosingFees",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "memberId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Commission ledger by agent, newest first",
      "collectionGroup": "commissionTransactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "agentId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "WhatsApp inbox: conversations, most recent first",
      "collectionGroup": "whatsappChats",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "lastMessageAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "WhatsApp inbox: delivery-status lookup by Gupshup message id",
      "collectionGroup": "messages",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "gsMessageId", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
